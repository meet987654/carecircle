# Signs login sessions; use a long random value for anything beyond a local demo.
# AUTH_SECRET=change-me

# Optional: use a real LLM for "Ask about today". Without these, the built-in
# template assistant is used (no network, deterministic).

# Groq (free tier): https://console.groq.com
# ASSISTANT_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=qwen/qwen3.8-27b
# Voice: Whisper speech-to-text works with the same Groq key (STT_MODEL defaults to
# whisper-large-v3-turbo).

# Natural server voice for spoken answers (otherwise the browser's voice is used).
# Deepgram Aura: free credit, no card, at https://console.deepgram.com
# TTS_PROVIDER=deepgram
# DEEPGRAM_API_KEY=...
# TTS_VOICE=aura-asteria-en   (fastest; aura-2-thalia-en is newer but ~1 s slower)

# Local Ollama instead (run `ollama pull llama3.2` first):
# ASSISTANT_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
